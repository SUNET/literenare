# Copy to .env and adjust. Values are referenced from config.yaml.

# Comma-separated client keys (X-API-Key or Authorization: Bearer). Empty = no auth.
LITERENARE_API_KEYS=

# JeV backend. protocol: systemone (POST {base}/systemone) or decide (serve_decide.py).
# Base URL includes /v1. From inside Docker, use host.docker.internal for the host machine.
JEV_PROTOCOL=systemone
JEV_BASE_URL=http://host.docker.internal:11434/v1
JEV_MODEL=nimble
JEV_API_KEY=

# Granian (all CLI flags have GRANIAN_* env equivalents).
GRANIAN_WORKERS=1
